# ==============================================================================
# Byte-compiled / optimized / DLL files
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==============================================================================
# Virtual Environments
# ==============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.local
.env.*.local
!.env.example

# ==============================================================================
# Jupyter Notebook Checkpoints & Cache
# ==============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==============================================================================
# Testing & Code Coverage
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ==============================================================================
# IDEs & Text Editors
# ==============================================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ==============================================================================
# Packaging & Distribution
# ==============================================================================
*.egg-info/
.eggs/
dist/
build/
*.whl

# ==============================================================================
# MLflow Artifacts
# ==============================================================================
mlruns/
mlartifacts/
mlflow.db
mlflow.db*

# ==============================================================================
# Operating System Artifacts
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
logs/
*.tmp
*.temp
scratch/

# ==============================================================================
# Machine Learning Artifacts & Checkpoints
# ==============================================================================
# Exclude model weights & serialized objects by default, whitelist frozen production models
models/*
!models/.gitkeep
!models/clv_tweedie_tuned_2010_09_10.joblib
!models/rfm_kmeans_k5_pipeline.joblib

# Processed datasets: exclude heavy pipeline intermediates, whitelist serving & test artifacts
data/processed/*
!data/processed/.gitkeep

# Re-include whitelisted subdirectories
!data/processed/clv/
!data/processed/features/
!data/processed/segmentation/

# Features: whitelist test and train cohorts (under 300 KB each)
data/processed/features/*
!data/processed/features/features_test_2011-09-10.parquet
!data/processed/features/features_train_2010-09-10.parquet

# Segmentation: whitelist only test cohort and profiles
data/processed/segmentation/*
!data/processed/segmentation/segments_t_seg_2011-09-10.parquet
!data/processed/segmentation/segment_profiles.csv
!data/processed/segmentation/segment_profiles.parquet

# CLV: whitelist holdout evaluation artifacts
!data/processed/clv/*

